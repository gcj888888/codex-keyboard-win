+/// Linux 版 Codex 的 arg0 别名有两种形态：指向「真实二进制所在目录」，或直接指向
+/// 二进制本身。两种都接受,但指向的 codex 必须是常规文件、属主可信、他人不可写、可执行。
+fn is_trusted_codex_bin_dir(target: &Path) -> bool {
+    let candidates = [target.join("codex"), target.to_path_buf()];
+    for candidate in candidates.iter() {
+        let Ok(metadata) = fs::symlink_metadata(candidate) else {
+            continue;
+        };
+        let owner = metadata.uid();
+        let mode = metadata.mode() & 0o777;
+        let is_file = metadata.file_type().is_file();
+        let trusted = is_file
+            && (owner == unsafe { libc::geteuid() } || owner == 0)
+            && mode & 0o022 == 0
+            && mode & 0o111 != 0;
+        if trusted {
+            return true;
+        }
+    }
+    false
+}
